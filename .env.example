# Required
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite+aiosqlite:///./smartskale.db
OPENAI_API_KEY=sk-your-openai-key
GROQ_API_KEY=gsk-your-groq-key
INTERVIEW_QUESTION_COUNT=5

# Production (Render sets these automatically via render.yaml)
# APP_ENV=production
# FRONTEND_URL=https://smartskale-web.onrender.com
# ALLOWED_ORIGINS=https://smartskale-web.onrender.com
# UPLOAD_DIR=/var/data/uploads

# Email (Gmail SMTP) — optional; verification links print to logs if unset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
