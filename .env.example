# Required
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite+aiosqlite:///./smartskale.db
GROQ_API_KEY=gsk-your-groq-key
INTERVIEW_QUESTION_COUNT=5

# Groq models (change if Groq updates model names)
GROQ_MODEL=llama-3.1-8b-instant
GROQ_WHISPER_MODEL=whisper-large-v3

# Optional — legacy OpenAI (not required when using Groq for questions + transcription)
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o

# Production (Render / AWS sets these in .env on the server)
# APP_ENV=production
# FRONTEND_URL=https://your-domain-or-ec2-ip
# ALLOWED_ORIGINS=https://your-domain-or-ec2-ip
# UPLOAD_DIR=/var/www/ai-interview-bot/uploads

# Email (Gmail SMTP) — optional; verification links print to logs if unset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
