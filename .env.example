# Required
SECRET_KEY=change-me-to-a-long-random-string

# Database — pick ONE (Postgres recommended for local dev):
# PostgreSQL via Docker (port 5433 — run scripts/dev_db_postgres.ps1 on Windows):
DATABASE_URL=postgresql+asyncpg://interview:interview@127.0.0.1:5433/interview_bot
# SQLite fallback (no Docker):
# DATABASE_URL=sqlite+aiosqlite:///./interview_bot.db

GROQ_API_KEY=gsk-your-groq-key
INTERVIEW_QUESTION_COUNT=5

# Groq models (change if Groq updates model names)
GROQ_MODEL=llama-3.1-8b-instant
GROQ_WHISPER_MODEL=whisper-large-v3

# Optional — legacy OpenAI (not required when using Groq)
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o

# Production (Render / AWS sets these in .env on the server)
# APP_ENV=production
# FRONTEND_URL=https://your-domain-or-ec2-ip
# ALLOWED_ORIGINS=https://your-domain-or-ec2-ip
# UPLOAD_DIR=/var/www/ai-interview-bot/uploads

# Optional S3 (when unset → local UPLOAD_DIR)
# S3_BUCKET=your-bucket-name
# S3_PREFIX=interview-bot
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1

# Retention TTLs (days) — cleanup script defaults to dry-run
# ARTIFACT_RETENTION_DAYS=90
# IDENTITY_RETENTION_DAYS=30
# RECORDING_RETENTION_DAYS=60

# Email (Gmail SMTP) — required for invite / verify / reset delivery in production.
# Use a Gmail App Password (16 chars), not your normal Gmail password.
# Keys: SMTP_HOST, SMTP_PORT, SMTP_EMAIL, SMTP_PASSWORD
# If unset, sends fail and links may print to logs in non-production only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
FRONTEND_URL=http://127.0.0.1:5173
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Coding sandbox (SandboxAPI RapidAPI and/or Piston)
CODING_QUESTIONS_ENABLED=true
CODING_JUDGE_BACKEND=auto
CODING_RAPIDAPI_KEY=
CODING_JUDGE_HOST=sandboxapi.p.rapidapi.com
# Optional self-hosted Piston; empty uses public EMKC when backend is auto/piston
CODING_PISTON_URL=
# JUDGE0_RAPIDAPI_KEY=   # legacy alias still accepted
