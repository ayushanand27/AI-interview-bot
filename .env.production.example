# ─────────────────────────────────────────────────────────────
# Production environment variables (SmartSkale InterviewBot)
# Copy to EC2 / Railway / your host — do NOT commit real secrets.
# ─────────────────────────────────────────────────────────────

# Database — pick ONE:
# EC2 free tier (simple, no extra service):
DATABASE_URL=sqlite+aiosqlite:////var/www/ai-interview-bot/data/smartskale.db
# Managed PostgreSQL (RDS, Supabase, Railway):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# Auth — generate SECRET_KEY with: openssl rand -hex 32
SECRET_KEY=generate-a-long-random-string-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Groq — questions, judging, transcription (required)
GROQ_API_KEY=gsk-your-key-here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_WHISPER_MODEL=whisper-large-v3

# OpenAI — optional legacy fallback
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o

# App
APP_ENV=production
DEBUG=False

# CORS — comma-separated; use your deployed frontend URL(s)
FRONTEND_URL=http://your-ec2-ip-or-domain
ALLOWED_ORIGINS=http://your-ec2-ip-or-domain

# File uploads
UPLOAD_DIR=/var/www/ai-interview-bot/uploads
MAX_FILE_SIZE_MB=10

# Interview defaults (optional)
INTERVIEW_QUESTION_COUNT=5

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
