# ─────────────────────────────────────────────────────────────
# Production environment variables (SmartSkale InterviewBot)
# Copy to Railway / your host dashboard — do NOT commit real secrets.
# ─────────────────────────────────────────────────────────────

# Database — Railway can inject DATABASE_URL automatically.
# For SQLite on a persistent volume, use a path under ./data/
DATABASE_URL=sqlite+aiosqlite:///./data/smartskale.db

# Auth — generate SECRET_KEY with: openssl rand -hex 32
SECRET_KEY=generate-a-long-random-string-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenAI — question generation, Whisper transcription
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Groq — LLM judge / answer scoring
GROQ_API_KEY=gsk-your-key-here

# App
APP_ENV=production
DEBUG=False

# CORS — comma-separated; use your deployed frontend URL(s)
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Interview defaults (optional — omit to use server default of 5)
# INTERVIEW_QUESTION_COUNT=5
