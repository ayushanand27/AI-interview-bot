# ─────────────────────────────────────────────────────────────
# Production environment (AI Interview Bot)
# Copy to the server as .env — do NOT commit real secrets.
# ─────────────────────────────────────────────────────────────

# Database — pick ONE:
# EC2 (simple):
DATABASE_URL=sqlite+aiosqlite:////var/www/ai-interview-bot/data/interview_bot.db
# Managed Postgres:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

SECRET_KEY=generate-a-long-random-string-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

GROQ_API_KEY=gsk-your-key-here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_WHISPER_MODEL=whisper-large-v3

APP_ENV=production
DEBUG=False

# Live HTTPS URL (DuckDNS / custom domain) — required for email links + CORS
FRONTEND_URL=https://ai-interview-bot.duckdns.org
ALLOWED_ORIGINS=https://ai-interview-bot.duckdns.org

UPLOAD_DIR=/var/www/ai-interview-bot/uploads
MAX_FILE_SIZE_MB=10
INTERVIEW_QUESTION_COUNT=5

# Optional S3 — leave blank to keep local uploads only
# S3_BUCKET=smartskale-interview-artifacts-YOURSUFFIX
# S3_PREFIX=interview-bot
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1

# Retention (days)
ARTIFACT_RETENTION_DAYS=90
IDENTITY_RETENTION_DAYS=30
RECORDING_RETENTION_DAYS=60

# Gmail SMTP — required for invite emails in production (App Password, not normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Coding sandbox — SandboxAPI RapidAPI and/or Piston (see docs/CODING_JUDGE_FREE_TIER.md)
CODING_QUESTIONS_ENABLED=true
CODING_JUDGE_BACKEND=auto
CODING_RAPIDAPI_KEY=
CODING_JUDGE_HOST=sandboxapi.p.rapidapi.com
CODING_PISTON_URL=
# JUDGE0_RAPIDAPI_KEY=   # legacy alias
