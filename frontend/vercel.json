{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://your-backend.railway.app/api/$1"
    },
    {
      "source": "/proctor/(.*)",
      "destination": "https://your-backend.railway.app/proctor/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
